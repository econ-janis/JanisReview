# Copiar a .env.local para desarrollo con `vercel dev`. En Vercel real,
# estas variables se cargan en Project Settings -> Environment Variables
# (nunca en el repo, nunca commiteadas).

# --- Postgres vía Neon (la provee automáticamente la integración de Neon
# al vincularla desde Vercel Marketplace; @vercel/postgres está deprecado) ---
# DATABASE_URL=

# --- AWS Secrets Manager (SOLO para leer credenciales de cliente; ver docs/DEPLOYMENT_PLAN_VERCEL.md) ---
# IAM de mínimo privilegio: solo secretsmanager:GetSecretValue sobre
# arn:aws:secretsmanager:*:*:secret:janis/clients/*/app-credentials-*
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# --- Auth server-to-server ---
INTERNAL_API_KEY=
# Vercel Cron manda `Authorization: Bearer $CRON_SECRET` automáticamente
# a /api/cron/dispatch si esta env var está configurada en el proyecto.
CRON_SECRET=

# --- Sesión del dashboard (defensa en profundidad, ver lib/auth.js) ---
SESSION_SECRET=
# sha256 hex de la passphrase interna — generar con:
# node -e "console.log(require('crypto').createHash('sha256').update(process.argv[1]).digest('hex'))" "la-passphrase"
DASHBOARD_ACCESS_PASSWORD_HASH=

# --- Maestro de clientes activos (PENDIENTE fuente automática, ver README) ---
ACTIVE_CLIENTS=

# --- Retención de histórico en días (default 180) ---
AUDIT_RESULTS_RETENTION_DAYS=180

# --- Overrides de host por ambiente (default: producción) ---
# JANIS_OMS_API_BASE_URL=https://oms.janisqa.in/api
# JANIS_DOM_API_BASE_URL=https://dom.janisqa.in/api
# JANIS_DELIVERY_API_BASE_URL=https://delivery.janisqa.in/api
# JANIS_PICKING_API_BASE_URL=https://picking.janisqa.in/api
# JANIS_TMS_API_BASE_URL=https://tms.janisqa.in/api
