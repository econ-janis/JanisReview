# Copiar a .env.local para desarrollo con `vercel dev`. En Vercel real,
# estas variables se cargan en Project Settings -> Environment Variables
# (nunca en el repo, nunca commiteadas).
#
# Esta variante NO usa AWS Secrets Manager ni ninguna base de datos: el
# usuario tipea appKey/appSecret/janisClient en el dashboard en cada
# auditoría, se usan una sola vez y se descartan. Lo único que hay que
# configurar es el acceso al dashboard en sí.

# --- Sesión del dashboard (defensa en profundidad sobre Deployment Protection de Vercel) ---
SESSION_SECRET=
# sha256 hex de la passphrase interna — generar con:
# node -e "console.log(require('crypto').createHash('sha256').update(process.argv[1]).digest('hex'))" "la-passphrase"
DASHBOARD_ACCESS_PASSWORD_HASH=

# --- Overrides de host por ambiente (default: producción) ---
# JANIS_OMS_API_BASE_URL=https://oms.janisqa.in/api
# JANIS_DOM_API_BASE_URL=https://dom.janisqa.in/api
# JANIS_DELIVERY_API_BASE_URL=https://delivery.janisqa.in/api
# JANIS_PICKING_API_BASE_URL=https://picking.janisqa.in/api
# JANIS_TMS_API_BASE_URL=https://tms.janisqa.in/api
